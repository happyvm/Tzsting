---
# Same as ansible-lint's built-in default (see ansiblelint/data/.yamllint)
# with only line-length raised: several of our preflight assertions build
# long-ish Jinja conditions/messages that read better on one line than
# wrapped, and 160 was an arbitrary legacy default anyway.
extends: default
rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start: disable
  line-length:
    max: 200
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
