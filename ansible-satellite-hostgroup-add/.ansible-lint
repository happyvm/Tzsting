---
profile: basic

skip_list:
  # satellite_hostgroup_add_result (set in roles/assign_hostgroup) is read
  # back by the playbook's set_stats task, so this project deliberately
  # uses a project-wide `satellite_hostgroup_add_` prefix instead of a
  # per-role one.
  - var-naming[no-role-prefix]

exclude_paths:
  - inventory/hosts.yml
