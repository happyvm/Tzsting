; Generated by ansible-sql-server-install - do not edit by hand.
; Deliberately contains no passwords/PID: those are passed as separate
; command-line switches to setup.exe (see roles/install/tasks/main.yml)
; and never persisted to disk, in Git, or in any Ansible log/artefact.
[OPTIONS]
ACTION="{{ 'RepairDatabaseEngine' if sql_server_operation == 'repair' else 'Install' }}"
QUIETSIMPLE="True"
IACCEPTSQLSERVERLICENSETERMS="True"
FEATURES={{ sql_server_features | join(',') }}
INSTANCENAME="{{ sql_server_instance_name }}"
INSTANCEID="{{ sql_server_instance_name }}"
SQLSVCACCOUNT="{{ sql_server_engine_service_account.name }}"
SQLSVCSTARTUPTYPE="Automatic"
AGTSVCACCOUNT="{{ sql_server_agent_service_account.name }}"
AGTSVCSTARTUPTYPE="Automatic"
SQLSYSADMINACCOUNTS="{{ sql_server_sysadmin_accounts | join('" "') }}"
SQLCOLLATION="{{ sql_server_collation }}"
{% if sql_server_authentication_mode == 'mixed' %}
SECURITYMODE="SQL"
{% endif %}
INSTALLSQLDATADIR="{{ sql_server_data_dir }}"
SQLUSERDBDIR="{{ sql_server_data_dir }}"
SQLUSERDBLOGDIR="{{ sql_server_log_dir }}"
SQLTEMPDBDIR="{{ sql_server_tempdb_dir }}"
SQLTEMPDBLOGDIR="{{ sql_server_tempdb_dir }}"
SQLTEMPDBFILECOUNT="{{ sql_server_tempdb_file_count }}"
SQLBACKUPDIR="{{ sql_server_backup_dir }}"
TCPENABLED="{{ '1' if sql_server_tcp_enabled | bool else '0' }}"
NPENABLED="0"
BROWSERSVCSTARTUPTYPE="{{ 'Automatic' if sql_server_browser_enabled | bool else 'Disabled' }}"
{% if sql_server_update_enabled | bool %}
UPDATEENABLED="True"
UPDATESOURCE="{{ sql_server_update_source }}"
{% else %}
UPDATEENABLED="False"
{% endif %}
