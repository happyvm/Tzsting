---
profile: basic

skip_list:
  # This project deliberately uses a project-wide `sccm_cd_` prefix on
  # register/set_fact vars produced in one role and read by another
  # (e.g. sccm_cd_deploy_result, set in roles/deploy_client, feeds
  # roles/verify and the playbook's own set_stats task).
  - var-naming[no-role-prefix]

exclude_paths:
  - inventory/hosts.yml
