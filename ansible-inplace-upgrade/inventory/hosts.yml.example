---
# Copy to hosts.yml. VMs are deliberately absent: ServiceNow/AAP supplies
# vm_name, target_ip and guest credentials at run time.
all:
  children:
    hyperv_hypervisor:
      hosts:
        hyperv-host01:
          ansible_host: hyperv-host01.example.local
          ansible_connection: winrm
          ansible_winrm_transport: kerberos
          ansible_port: 5986
          ansible_user: "{{ vault_hyperv_username }}"
          ansible_password: "{{ vault_hyperv_password }}"
